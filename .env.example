# Kopiraj u .env i upiši svoje ključeve (datoteka .env se NE commita).

# Ticketmaster Discovery API — besplatno: https://developer.ticketmaster.com/ (5000 poziva/dan)
TICKETMASTER_API_KEY=

# Last.fm API — besplatno: https://www.last.fm/api/account/create (popularnost izvođača)
LASTFM_API_KEY=

# SeatGeek Platform API (opcionalno, uglavnom SAD/UK): https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=

# Zadane države/regije za pretragu (ISO kodovi i/ili regije, odvojeni zarezom):
#   otvoreno (zadano), europa, zapadna_europa, srednja_europa, dach, nordijske, balkan,
#   sjeverna_amerika, latam, oceanija, azija, svijet   – popis: karte markets
KARTE_COUNTRIES=otvoreno

# Država tvog prebivališta (koje platforme te primaju kao prodavatelja, rizik pristupa tržištu)
KARTE_SELLER_COUNTRY=HR

# Zadani budžet u EUR (koristi se za preporuku količine)
KARTE_BUDGET=1000
