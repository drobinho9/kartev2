# Kopiraj u .env i upiši svoje ključeve (datoteka .env se NE commita).
# BEZ IJEDNOG KLJUČA aplikacija radi sa snimkom stvarnih događaja (karte snimka) + Deezer/Wikipedia.
# Usporedba svih izvora i što napraviti kad Ticketmaster ne odobri ključ: docs/IZVORI_PODATAKA.md

# --- Događaji (dovoljan je bilo koji jedan) -------------------------------------------------------
# Ticketmaster Discovery API — besplatno: https://developer.ticketmaster.com/ (5000 poziva/dan).
# Ključ je "Consumer Key" u My Apps; ako piše "pending", vidi docs/IZVORI_PODATAKA.md.
TICKETMASTER_API_KEY=

# SerpApi → Google Events (najbolja zamjena za Ticketmaster u Europi/HR) — https://serpapi.com
# Besplatno 250 pretraga mjesečno (1 grad = 1 pretraga; rezultati se cacheiraju 24 h).
SERPAPI_KEY=
# Gradovi za Google Events (prazno = glavni gradovi odabranih država). Format: grad[:ISO], ...
KARTE_SERPAPI_GRADOVI=

# PredictHQ — https://control.predicthq.com (14 dana probno, zatim besplatno samo za spremljene lokacije)
PREDICTHQ_TOKEN=
# ID-evi spremljenih lokacija za besplatni plan (Location Insights), odvojeni zarezom
PREDICTHQ_LOCATIONS=

# SeatGeek Platform API (opcionalno, uglavnom SAD/UK): https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=

# --- Popularnost izvođača ------------------------------------------------------------------------
# Last.fm API — besplatno: https://www.last.fm/api/account/create (bez njega se koristi Deezer, bez ključa)
LASTFM_API_KEY=

# Wikimedia (Wikipedia pregledi, turneje i otkrivanje turneja) traži opisni User-Agent s kontaktom (e-mail ili URL).
# Isti User-Agent šalje se i RSS izvorima najava (karte najave). Bez njega se šalje općeniti "karte/<verzija>".
# Primjer: KARTE_USER_AGENT=karte/0.7 (ime@primjer.hr)
KARTE_USER_AGENT=

# --- Postavke ------------------------------------------------------------------------------------
# Zadane države/regije za pretragu (ISO kodovi i/ili regije, odvojeni zarezom):
#   otvoreno (zadano), europa, zapadna_europa, srednja_europa, dach, nordijske, balkan,
#   sjeverna_amerika, latam, oceanija, azija, svijet   – popis: karte markets
KARTE_COUNTRIES=otvoreno

# Država tvog prebivališta (koje platforme te primaju kao prodavatelja, rizik pristupa tržištu)
KARTE_SELLER_COUNTRY=HR

# Zadani budžet u EUR (koristi se za preporuku količine)
KARTE_BUDGET=1000

# Mapa za dnevnik prodaja i osvježenu snimku (zadano ~/.karte)
# KARTE_DATA_DIR=
